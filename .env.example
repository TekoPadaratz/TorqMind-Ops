POSTGRES_DB=torqmind_ops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
JWT_SECRET=trocar-para-segredo-forte

# Storage: local (padrão) ou gdrive
STORAGE_PROVIDER=local
GDRIVE_ROOT_FOLDER_ID=1Ab-fynAW0c7Cpx-zjXUIE2xvNCVpWEC9
# Caminho do JSON da conta de serviço DENTRO do container (monte o volume manualmente)
# GDRIVE_CREDENTIALS_FILE=/app/secrets/gdrive-service-account.json
# Ou cole o JSON inteiro (cuidado no .env):
# GDRIVE_CREDENTIALS_JSON=

# Voz (chave só no backend). Sem a chave, use transcrição manual + provider deterministic.
VOICE_ENABLED=true
VOICE_TRANSCRIPTION_PROVIDER=deterministic
VOICE_INTENT_PROVIDER=deterministic
VOICE_OPENAI_API_KEY=
# VOICE_OPENAI_BASE_URL=https://api.openai.com/v1
# VOICE_TRANSCRIBE_MODEL=whisper-1
# VOICE_INTENT_MODEL=gpt-4o-mini
