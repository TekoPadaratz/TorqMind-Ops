POSTGRES_DB=torqmind_ops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
JWT_SECRET=trocar-por-um-segredo-aleatorio-com-ao-menos-32-caracteres

# Primeiro acesso em banco novo. Remova estas variáveis após o usuário ser criado.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=Administrador

# Storage: local (padrão) ou gdrive
STORAGE_PROVIDER=local
GDRIVE_ROOT_FOLDER_ID=1Ab-fynAW0c7Cpx-zjXUIE2xvNCVpWEC9
